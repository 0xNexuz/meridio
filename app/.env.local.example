# Copy to .env.local and fill in. Never commit .env.local.

# Solana RPC. Devnet is fine for the hackathon; a Helius/QuickNode devnet URL is more reliable.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Circle's devnet USDC (get test tokens at https://faucet.circle.com).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pickup-station key. This keypair pays transaction fees so students need no SOL,
# and co-signs each pickup. Generate one with:  solana-keygen new -o station.json --no-bip39-passphrase
# then paste the JSON array here (e.g. [12,34,...]). Fund it with a little devnet SOL.
STATION_SECRET_KEY=

# Any long random string (used to sign the vendor's short-lived station session).
#   openssl rand -hex 32
SESSION_SECRET=

# Optional sponsor integrations (price check, voice updates).
FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=
